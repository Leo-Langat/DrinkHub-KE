# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://drinkhub_user:drinkhub_pass_2026@localhost:5432/drinkhub_db?schema=public

# Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production_2026
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Kenya Safaricom M-Pesa Integration (Daraja API)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_PASSKEY=your_mpesa_passkey
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/payments/mpesa/callback
